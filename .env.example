# Plantilla de entorno: copiar a .env (gitignored) o inyectar por entorno/gestor de secretos.
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abys
DB_USER=postgres
# Placeholder falso: nunca versionar un valor real. La contraseña real se inyecta
# por entorno/gestor de secretos en el despliegue y debe rotarse fuera del repo.
DB_PASSWORD=cambiar-en-despliegue
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10
# Orígenes CORS permitidos: lista separada por coma (el parser ignora espacios y vacíos).
# Desarrollo usa http://localhost:5173; en producción, enumerar orígenes explícitos.
# El comodín '*' está prohibido en producción.
CORS_ORIGIN=http://localhost:5173
